{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymized persona card, the only card content a decision model ever sees",
  "type": "object",
  "additionalProperties": false,
  "required": ["persona_id", "role", "professional_background", "decision_priorities", "risk_attitude", "time_horizon", "organizational_constraints"],
  "properties": {
    "persona_id": { "type": "string", "pattern": "^P-(CFO|CIO|COO)-[1-5]$" },
    "role": { "enum": ["CFO", "CIO", "COO"] },
    "professional_background": { "type": "string", "maxLength": 600 },
    "decision_priorities": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": { "type": "string", "maxLength": 160 }
    },
    "risk_attitude": { "type": "string", "maxLength": 240 },
    "time_horizon": { "type": "string", "maxLength": 240 },
    "organizational_constraints": {
      "type": "array", "minItems": 2, "maxItems": 4,
      "items": { "type": "string", "maxLength": 200 }
    }
  }
}
